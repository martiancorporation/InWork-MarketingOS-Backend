# Canonical reference — every supported variable. Copy the template for your
# environment instead of this file: .env.local.example / .env.development.example /
# .env.production.example. Loading order: .env then .env.$APP_ENV, then real OS env vars win.

# ---- Application ----
APP_NAME=InWork MarketingOS API
APP_ENV=local                 # local | development | production
DEBUG=false                   # true only for local dev
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
AUDIT_ENABLED=true             # logs every API request to audit_log
AI_USAGE_ENABLED=true          # logs every AI call's tokens/cost
PUBLIC_API_BASE_URL=https://api.example.com/api/v1  # for signed upload links

# ---- Security / Auth ----
SECRET_KEY=                    # >=32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ENCRYPTION_KEY=                 # encrypts stored OAuth tokens; falls back to SECRET_KEY if unset
ACCESS_TOKEN_EXPIRE_MINUTES=420 # 7 hours
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # explicit origins only, no '*'
RATE_LIMIT_ENABLED=true        # limiter on login + paid-AI routes
RATE_LIMIT_BACKEND=memory      # memory | redis. memory is PER-WORKER: with N gunicorn
                               # workers the effective limit is times x N, not times.
# REDIS_URL=redis://localhost:6379/0   # required when RATE_LIMIT_BACKEND=redis (one
                               # shared limit across every worker/replica). Also
                               # uncomment `redis` in requirements.txt.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8       # trust X-Forwarded-For only from this CIDR
# MAX_REQUEST_BODY_BYTES=26214400      # hard cap on any request body

# ---- Database ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inwork
DATABASE_ECHO=false            # log SQL statements (dev only)
DATABASE_POOL_SIZE=5           # (POOL_SIZE + MAX_OVERFLOW) x workers must stay under the DB ceiling
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ---- OpenRouter — primary LLM provider, optional, degrades gracefully if unset ----
# OpenRouter proxies many vendors behind one OpenAI-compatible API — model ids
# are "vendor/model" (e.g. anthropic/claude-sonnet-5, openai/gpt-4o,
# google/gemini-2.5-pro). See app/integrations/llm/ — the ONE place to swap
# LLM providers; everything else calls get_llm_client(), never a vendor class.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash   # ceiling default for anything not routed below
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2        # client-side retries on connection failures
# Per-task-category model routing (classification/extraction/summarization/...)
# is no longer a static env var — it lives in the admin-editable
# `ai_model_routes` DB table (see app/ai/model_router.py), managed via
# GET/PUT /admin/ai-model-routes. Falls back to built-in research-backed
# defaults if the table is empty.
OPENROUTER_SITE_URL=            # optional — OpenRouter attribution (HTTP-Referer)
OPENROUTER_APP_NAME=InWork MarketingOS   # optional — OpenRouter attribution (X-Title)
AI_PRICING_JSON=                # optional per-1M-token pricing override, JSON

# ---- Cross-provider QA (a second vendor reviews the generator's output) ----
AI_QA_ENABLED=false
AI_QA_PROVIDER=openai           # openai | openrouter

# ---- OpenAI-compatible provider (used as the QA reviewer) ----
OPENAI_API_KEY=                 # blank keeps QA off
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=30

# ---- Object storage / file uploads (Amazon S3) ----
STORAGE_PROVIDER=s3            # uploads return 503 until bucket + region are set
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_AWS_ACCESS_KEY_ID=      # blank in production to use the instance IAM role
STORAGE_AWS_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT_URL=http://localhost:4566   # LocalStack / S3-compatible
STORAGE_KEY_PREFIX=uploads
STORAGE_SSE=AES256              # AES256 or aws:kms
STORAGE_PRESIGN_EXPIRY_SECONDS=900   # download-URL TTL, 15 min
STORAGE_MAX_UPLOAD_BYTES=20971520    # 20 MB
# STORAGE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg   # "*" disables the check

# ---- Client intelligence (async profile + RAG) ----
# Runs with no config (local embedder fallback). Set a Voyage key to upgrade retrieval.
# INTEL_VOYAGE_API_KEY=
# INTEL_ENABLED=false             # kill-switch
# INTEL_EMBEDDING_PROVIDER=voyage # voyage | fake (deterministic, no key needed)
# INTEL_EMBEDDING_MODEL=voyage-3
# INTEL_RETRIEVAL_TOP_K=8
# Don't set INTEL_EMBEDDING_DIM/CHUNK_CHARS/CHUNK_OVERLAP_CHARS/MAX_CORPUS_CHARS/MAX_DOCUMENT_CHARS
# here — tuned code defaults; EMBEDDING_DIM is tied to a pgvector column + migration.

# ---- Scheduler cadence (python -m app.scheduler) ----
# SCHEDULER_TICK_SECONDS=30
# SCHEDULER_SWEEP_CONCURRENCY=10   # clients processed at once per sweep
# SCHEDULER_WATCHDOG_INTERVAL_MINUTES=60
# SCHEDULER_INTEGRATION_SYNC_INTERVAL_MINUTES=360
# SCHEDULER_DIGEST_INTERVAL_MINUTES=1440   # daily
# SCHEDULER_DIGEST_ENABLED=true
# SCHEDULER_SESSION_PURGE_INTERVAL_MINUTES=60
# SCHEDULER_AUDIT_LOG_RETENTION_DAYS=365
# SCHEDULER_AUDIT_LOG_PURGE_INTERVAL_MINUTES=1440
# SCHEDULER_REPORT_EMAIL_ENABLED=true
# SCHEDULER_REPORT_EMAIL_CHECK_INTERVAL_MINUTES=10
# SCHEDULER_NOTIFICATION_EMAIL_ENABLED=true
# SCHEDULER_NOTIFICATION_EMAIL_INTERVAL_MINUTES=15
# SCHEDULER_AUTO_PLAN_GENERATION_ENABLED=true   # auto-draft next month's content plan on/after the 15th
# SCHEDULER_AUTO_PLAN_GENERATION_CHECK_INTERVAL_MINUTES=60

# ---- Brevo (daily report + notification email delivery) ----
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=InWork MarketingOS

# ---- Google (OAuth / GA4 / Search Console / Ads / LSA) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DEVELOPER_TOKEN=         # Google Ads only: approved developer token
GOOGLE_ADS_API_VERSION=v22

# ---- Meta Business ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v21.0
META_SCOPES=ads_read,business_management

# ---- LinkedIn Ads ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202506     # monthly version, YYYYMM — verify against LinkedIn's current docs; ~1yr support window
LINKEDIN_SCOPES=r_ads,r_ads_reporting

# ---- GoHighLevel / LeadConnector ----
# Tokens themselves are handed to us out-of-band per client (Private App, not
# an OAuth redirect through our app) — these two are only used to refresh an
# expired access token via GHL's OAuth endpoint.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# ---- Demo data — off by default, do NOT enable in production ----
DEMO_SEED_ON_CREATE=false       # seeds 90-day synthetic analytics for new clients
# DEMO_SEED_DAYS=90

# ---- Scraping / research (brand extraction) ----
SCRAPINGBEE_API_KEY=            # proxied JS-rendering fetch; blank falls back to plain scrape
BRAVE_API_KEY=                  # optional brand research folded into AI context
