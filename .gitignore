# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment & secrets — ignore real env files, keep the *.example templates.
.env
.env.*
!.env.example
!.env.*.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Scripts directory — track operational scripts (the Docker entrypoint must be
# tracked or the image build breaks), but keep out generated/local-only files.
scripts/__pycache__/
scripts/api_test_results.json
# Contains a hardcoded production host + provisions SSH access + scp's the local
# .env (real secrets) to a remote server — deliberately kept local-only, never
# committed. Ask before removing this line.
scripts/deploy.sh
